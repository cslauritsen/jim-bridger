# Required
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/jim-bridger-queue
SQS_DLQ_URL=https://sqs.us-east-1.amazonaws.com/123456789012/jim-bridger-dlq

# Optional (defaults shown)
AWS_REGION=us-east-2
SQS_MAX_RETRIES=5
SQS_POLL_WAIT=20
SQS_VISIBILITY_TIMEOUT=300
ALIAS_CONFIG_PATH=/etc/jim-bridger/aliases.json
DEFAULT_RECIPIENT=csl
FORWARDER_ADDRESS=ses-forwarder@example.com
LDA_PATH=/usr/lib/dovecot/dovecot-lda
LOG_LEVEL_ROOT=info
