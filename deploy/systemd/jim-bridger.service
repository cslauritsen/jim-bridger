[Unit]
Description=Jim Bridger SQS mail processor
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=jim-bridger
Group=jim-bridger
EnvironmentFile=/etc/jim-bridger/jim-bridger.env
ExecStart=/usr/local/bin/jim_bridger
WorkingDirectory=/var/lib/jim-bridger
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/jim-bridger

[Install]
WantedBy=multi-user.target
